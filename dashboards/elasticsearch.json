      "targets": [
        {
          "refId": "A",
          "expr": "rate(es_indexing_documents_total{cluster=~\"${cluster:regex}\",node=~\"${node:regex}\"}[$__rate_interval])",
          "legendFormat": "{{node}}",
          "datasource": {
            "type": "prometheus",
            "uid": "demo-prometheus"
          },
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Thread pool rejections",
      "description": "Rejected search tasks per second. Sustained rejections warrant workload investigation.",
      "datasource": {
        "type": "prometheus",
        "uid": "demo-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(es_search_thread_pool_rejections_total{cluster=~\"${cluster:regex}\",node=~\"${node:regex}\"}[$__rate_interval])",
          "legendFormat": "{{node}}",
          "datasource": {
            "type": "prometheus",
            "uid": "demo-prometheus"
          },
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Memory usage",
      "description": "Simulated node resident memory consumption, including non-heap use.",
      "datasource": {
        "type": "prometheus",
        "uid": "demo-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "es_memory_used_bytes{cluster=~\"${cluster:regex}\",node=~\"${node:regex}\"}",
          "legendFormat": "{{node}}",
          "datasource": {
            "type": "prometheus",
            "uid": "demo-prometheus"
          },
          "range": true

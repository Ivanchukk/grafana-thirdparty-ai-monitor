{
  "uid": "elasticsearch-demo",
  "title": "Elasticsearch \u00b7 Infrastructure Overview",
  "description": "Three simulated nodes with real Prometheus time series. Activate incidents from the local exporter API.",
  "schemaVersion": 41,
  "version": 1,
  "tags": [
    "aiops",
    "demo",
    "elasticsearch"
  ],
  "timezone": "browser",
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "editable": false,
  "links": [
    {
      "title": "Analyze with AI",
      "url": "/a/local-aiops-app/investigate?dashboard=elasticsearch-demo",
      "includeVars": true,
      "keepTime": true,
      "type": "link"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "cluster",
        "label": "Cluster",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "demo-prometheus"
        },
        "query": "label_values(es_node_up, cluster)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      },
      {
        "name": "node",
        "label": "Node",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "demo-prometheus"
        },
        "query": "label_values(es_node_up{cluster=~\"${cluster:regex}\"}, node)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "CPU usage",
      "description": "CPU utilization by Elasticsearch node. Compare with request volume and GC activity.",
      "datasource": {
        "type": "prometheus",
        "uid": "demo-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "es_cpu_usage_ratio{cluster=~\"${cluster:regex}\",node=~\"${node:regex}\"}",
          "legendFormat": "{{node}}",
          "datasource": {
            "type": "prometheus",
            "uid": "demo-prometheus"
          },
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "JVM heap usage",
      "description": "Total JVM heap occupancy, not old-generation pressure. Demo warning above 85%.",
      "datasource": {
        "type": "prometheus",
        "uid": "demo-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "es_jvm_heap_usage_ratio{cluster=~\"${cluster:regex}\",node=~\"${node:regex}\"}",
          "legendFormat": "{{node}}",
          "datasource": {
            "type": "prometheus",
            "uid": "demo-prometheus"
          },
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Garbage collection activity",
      "description": "Fraction of wall time spent in GC, computed from a cumulative seconds counter.",
      "datasource": {
        "type": "prometheus",
        "uid": "demo-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(es_jvm_gc_seconds_total{cluster=~\"${cluster:regex}\",node=~\"${node:regex}\"}[$__rate_interval])",
          "legendFormat": "{{node}}",
          "datasource": {
            "type": "prometheus",
            "uid": "demo-prometheus"
          },
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Search latency \u00b7 p95",
      "description": "Estimated 95th percentile request duration from classic histogram buckets.",
      "datasource": {
        "type": "prometheus",
        "uid": "demo-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, cluster, node) (rate(es_search_duration_seconds_bucket{cluster=~\"${cluster:regex}\",node=~\"${node:regex}\"}[$__rate_interval])))",
          "legendFormat": "{{node}}",
          "datasource": {
            "type": "prometheus",
            "uid": "demo-prometheus"
          },
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Search throughput",
      "description": "Search requests per second. The cumulative counter is converted to a rate.",
      "datasource": {
        "type": "prometheus",
        "uid": "demo-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(es_search_requests_total{cluster=~\"${cluster:regex}\",node=~\"${node:regex}\"}[$__rate_interval])",
          "legendFormat": "{{node}}",
          "datasource": {
            "type": "prometheus",
            "uid": "demo-prometheus"
          },
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Indexing throughput",
      "description": "Indexed documents per second, calculated from a cumulative counter.",
      "datasource": {
        "type": "prometheus",
        "uid": "demo-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8

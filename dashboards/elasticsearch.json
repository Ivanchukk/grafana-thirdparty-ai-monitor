          "sort": "desc"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Active connections",
      "description": "Open client connections per node, related to simulated search demand.",
      "datasource": {
        "type": "prometheus",
        "uid": "demo-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "es_active_connections{cluster=~\"${cluster:regex}\",node=~\"${node:regex}\"}",
          "legendFormat": "{{node}}",
